{
  "version": 2,
  "installCommand": "npm install --prefix apps/api --legacy-peer-deps && npm install --prefix apps/web --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "{apps/api/dist/**,apps/api/node_modules/**,apps/api/package.json,apps/api/node_modules/@nestjs/**,apps/api/node_modules/typeorm/**,apps/api/node_modules/pg/**,apps/api/node_modules/express/**,apps/api/node_modules/rxjs/**,apps/api/node_modules/reflect-metadata/**,apps/api/node_modules/class-validator/**,apps/api/node_modules/class-transformer/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
